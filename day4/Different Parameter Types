class Display {
    void show(int number) {
        System.out.println("Integer: " + number);
    }

    void show(String text) {
        System.out.println("String: " + text);
    }

    public static void main(String[] args) {
        Display d = new Display();

        d.show(100);
        d.show("Java");
    }
}

Output:

Integer: 100
String: Java
